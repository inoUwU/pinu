{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "overview-board",
      "x": 0,
      "y": 0,
      "name": "PINU Wireframe Overview",
      "width": 520,
      "height": 980,
      "fill": "$panel",
      "cornerRadius": 24,
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$line"
      },
      "layout": "vertical",
      "gap": 16,
      "padding": 24,
      "children": [
        {
          "type": "text",
          "id": "overview-title",
          "fill": "$ink",
          "content": "PINU Wireframe Map",
          "fontFamily": "Inter",
          "fontSize": 30,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "overview-subtitle",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Source: docs/spec/list_of_screens.md and docs/spec/reverse_engineered_system_spec.md.\nImplementation audit: frontend/app routes, shared layouts, hooks, and local runtime check on 2026-04-29.",
          "fontFamily": "Inter",
          "fontSize": 13
        },
        {
          "type": "frame",
          "id": "overview-legend",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "overview-legend-title",
              "fill": "$ink",
              "content": "Legend",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "overview-legend-row",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "legend-implemented",
                  "fill": "$implemented-bg",
                  "cornerRadius": 999,
                  "padding": [
                    6,
                    10
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "legend-implemented-text",
                      "fill": "$implemented-ink",
                      "content": "実装あり",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "legend-scaffold",
                  "fill": "$scaffold-bg",
                  "cornerRadius": 999,
                  "padding": [
                    6,
                    10
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "legend-scaffold-text",
                      "fill": "$scaffold-ink",
                      "content": "骨組みのみ",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "legend-spec",
                  "fill": "$spec-bg",
                  "cornerRadius": 999,
                  "padding": [
                    6,
                    10
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "legend-spec-text",
                      "fill": "$spec-ink",
                      "content": "仕様のみ",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FwiVu",
                  "name": "runtimeLegend",
                  "fill": "$runtime-bg",
                  "cornerRadius": 999,
                  "padding": [
                    6,
                    10
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "XubtZ",
                      "fill": "$runtime-ink",
                      "content": "実ラン空画面",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "700"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "overview-client",
          "width": "fill_container",
          "height": 248,
          "fill": "$soft",
          "cornerRadius": 14,
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$line"
          },
          "layout": "vertical",
          "gap": 8,
          "padding": 12,
          "children": [
            {
              "type": "text",
              "id": "overview-client-title",
              "fill": "$ink",
              "content": "Client routes: code vs runtime",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "overview-client-body",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "/: hello + mock fetch only, runtime blank\n/category: code has 2 dummy cards, runtime blank\n/[categoryid]: placeholder, runtime blank\n/[categoryid]/[mid]: placeholder, runtime blank\n/order: title + CTA + bottom nav render\n/history: code suggests sample table, runtime blank\n/checkout: code suggests thank-you page, runtime blank",
              "lineHeight": 1.2,
              "fontFamily": "Inter",
              "fontSize": 13
            }
          ]
        },
        {
          "type": "frame",
          "id": "overview-admin",
          "width": "fill_container",
          "height": 268,
          "fill": "$soft",
          "cornerRadius": 14,
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$line"
          },
          "layout": "vertical",
          "gap": 8,
          "padding": 12,
          "children": [
            {
              "type": "text",
              "id": "overview-admin-title",
              "fill": "$ink",
              "content": "Admin routes: code vs runtime",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "overview-admin-body",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "/admin/login: form in code, runtime blank\n/admin: analytics in code, runtime blank\n/admin/menu: runtime verified with category columns\n/admin/operation: runtime verified with dummy kitchen cards\n/admin/bill: table grid in code, runtime blank\n/admin/user: CRUD table in code, runtime blank\n/admin/qrcode: QR generator in code, runtime blank\n/admin/settings: heading only in runtime",
              "lineHeight": 1.2,
              "fontFamily": "Inter",
              "fontSize": 13
            }
          ]
        },
        {
          "type": "frame",
          "id": "overview-gaps",
          "width": "fill_container",
          "height": 220,
          "fill": "$soft",
          "cornerRadius": 14,
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$line"
          },
          "layout": "vertical",
          "gap": 8,
          "padding": 12,
          "children": [
            {
              "type": "text",
              "id": "overview-gaps-title",
              "fill": "$ink",
              "content": "Spec + runtime gaps",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "overview-gaps-body",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Runtime check on 2026-04-29 exposed several effectively blank routes. Browser logs also showed sync dynamic params misuse, script tags inside React trees, and duplicate-key warnings.\nThe wireframes below now separate code intent from what was actually visible in the running app.",
              "lineHeight": 1.2,
              "fontFamily": "Inter",
              "fontSize": 13
            }
          ]
        }
      ]
    },
